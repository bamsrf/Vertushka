{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "channel": "preview-android",
        "buildType": "apk",
        "env": {
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "channel": "production-android",
        "buildType": "app-bundle",
        "env": {
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6774999020",
        "appleTeamId": "G47JLHB869"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    }
  }
}
