    "infoPlist": {
      "CADisableMinimumFrameDurationOnPhone": true,
      "CFBundleAllowMixedLocalizations": true,
      "CFBundleDevelopmentRegion": "$(DEVELOPMENT_LANGUAGE)",
      "CFBundleExecutable": "$(EXECUTABLE_NAME)",
      "CFBundleIdentifier": "$(PRODUCT_BUNDLE_IDENTIFIER)",
      "CFBundleInfoDictionaryVersion": "6.0",
      "CFBundleName": "$(PRODUCT_NAME)",
      "CFBundlePackageType": "$(PRODUCT_BUNDLE_PACKAGE_TYPE)",
      "CFBundleShortVersionString": "1.0.1",
      "CFBundleSignature": "????",
      "CFBundleURLTypes": [
        {
          "CFBundleURLSchemes": [
            "vertushka",
            "com.vertushka.app"
          ]
        },
        {
          "CFBundleURLSchemes": [
            "exp+vertushka"
          ]
        }
      ],
      "CFBundleVersion": "1",
      "ITSAppUsesNonExemptEncryption": false,
      "LSMinimumSystemVersion": "12.0",
      "LSRequiresIPhoneOS": true,
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": false,
        "NSAllowsLocalNetworking": true
      },
      "NSBonjourServices": [
        "_expo._tcp"
      ],
      "NSCameraUsageDescription": "Приложению нужен доступ к камере для сканирования штрихкодов и распознавания обложек пластинок",
      "NSLocalNetworkUsageDescription": "Expo Dev Launcher uses the local network to discover and connect to development servers running on your computer.",
      "NSPhotoLibraryAddUsageDescription": "Чтобы сохранять обложки пластинок в галерею",
      "NSPhotoLibraryUsageDescription": "Чтобы выбрать фото для аватара и обложек пластинок из вашей галереи",
      "NSUserActivityTypes": [
        "$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route"
      ],
      "RCTMetroPort": "$(RCT_METRO_PORT)",
      "UILaunchStoryboardName": "SplashScreen",
      "UIRequiredDeviceCapabilities": [
        "arm64"
      ],
      "UIRequiresFullScreen": false,
      "UIStatusBarStyle": "UIStatusBarStyleDefault",
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown"
      ],
      "UIViewControllerBasedStatusBarAppearance": false,
      "CFBundleDisplayName": "Вертушка",
      "UIUserInterfaceStyle": "Light"
    },
    "entitlements": {
      "aps-environment": "development",
      "com.apple.developer.applesignin": [
        "Default"
      ]
    }
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAFBFF",
        "ios": {
          "enableFullScreenImage_legacy": true
        }
      }
    ],
    [
      "expo-secure-store",
      {
        "faceIDPermission": false
      }
    ],
    "expo-apple-authentication",
    [
      "expo-camera",
      {
        "cameraPermission": "Приложению нужен доступ к камере для сканирования штрихкодов и распознавания обложек пластинок",
        "microphonePermission": false
      }
    ],
    "@sentry/react-native",
    "./plugins/withSentryDisableLocalUpload",
    [
      "expo-notifications",
      {
        "icon": "./assets/images/notification-icon.png",
        "color": "#2A4BD7",
        "defaultChannel": "default"
      }
    ],
    "expo-font",
    "expo-web-browser",
    "expo-video",
    [
      "expo-build-properties",
      {
        "android": {
          "minSdkVersion": 26
        }
      }
    ]
  ],
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "updates": {
    "url": "https://u.expo.dev/a603ba4b-61d4-4179-9384-e5f3ed4e4bca"
  },
  "newArchEnabled": true,
  "version": "1.0.1",
  "sdkVersion": "57.0.0"
}
