# ===========================================
# Настройки продакшена для Вертушка API
# ===========================================
# ВАЖНО: Скопируй этот файл как .env.prod и заполни реальными значениями!
# cp .env.prod.example .env.prod

# -------------------------------------------
# Безопасность (ОБЯЗАТЕЛЬНО СГЕНЕРИРОВАТЬ НОВЫЕ!)
# -------------------------------------------
# Генерация: openssl rand -hex 32
SECRET_KEY=сгенерируй-командой-openssl-rand-hex-32

# Генерация: openssl rand -hex 64
JWT_SECRET_KEY=сгенерируй-командой-openssl-rand-hex-64

# -------------------------------------------
# База данных
# -------------------------------------------
# Генерация пароля: openssl rand -base64 24
DB_USER=vertushka_user
DB_PASSWORD=сгенерируй-надежный-пароль

# -------------------------------------------
# Режим работы
# -------------------------------------------
DEBUG=false

# -------------------------------------------
# URLs
# -------------------------------------------
APP_URL=https://api.vertushka.ru
FRONTEND_URL=https://vertushka.ru

# -------------------------------------------
# Discogs API (получить на https://www.discogs.com/settings/developers)
# -------------------------------------------
DISCOGS_API_KEY=твой_ключ_от_discogs
DISCOGS_API_SECRET=твой_секрет_от_discogs
DISCOGS_USER_AGENT=VertushkaApp/1.0

# -------------------------------------------
# Apple Sign In (опционально)
# -------------------------------------------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Содержимое .p8 (Sign in with Apple key). Обязателен: без него нельзя
# отозвать токен при удалении аккаунта — реджект по Guideline 5.1.1(v).
# Переносы строк экранировать: APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# -------------------------------------------
# Google Sign In (опционально)
# -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------
# Email уведомления (опционально)
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@vertushka.ru

# -------------------------------------------
# Служебный токен (health/detailed, health/covers, covers refresh)
# -------------------------------------------
# Без него служебные ручки отдают 403 вообще всем, включая владельца.
# Сгенерировать: openssl rand -hex 32
INTERNAL_API_TOKEN=

# --- Дрип обложек: ПРЕ-РЕЛИЗНЫЙ профиль (снять перед App Store!) ---
# Пока DAU 0, дрип может жечь простаивающий Discogs-bucket агрессивнее.
# Перед релизом эти три строки УДАЛИТЬ и пересоздать scheduler — дефолты
# вернут щадящие ~10 req/min. Границы: headroom >= 16, pace >= 1.0 —
# контейнер не стартует с более жирными значениями (см. config.py).
# COVER_DRIP_HEADROOM=18
# COVER_DRIP_MAX_PER_RUN=35
# COVER_DRIP_PACE_SEC=1.0
