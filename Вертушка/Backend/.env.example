# Настройки приложения
APP_NAME=RecordScanner
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recordscanner

# JWT настройки
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Discogs API
DISCOGS_API_KEY=afd72017-b040-4a22-833e-89b50e99f884
DISCOGS_API_SECRET=your-discogs-api-secret
DISCOGS_USER_AGENT=RecordScannerApp/1.0

# OpenAI API (распознавание обложки пластинки)
OPENAI_API_KEY=your-openai-api-key

# Apple Sign In
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
# Содержимое .p8 (Sign in with Apple key). Обязателен: без него нельзя
# отозвать токен при удалении аккаунта — реджект по Guideline 5.1.1(v).
# Переносы строк экранировать: APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# Google Sign In
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email настройки (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@recordscanner.app

# URL приложения
APP_URL=http://localhost:8000
FRONTEND_URL=https://recordscanner.app

# Публичный домен: HTML-страницы app/web/ и редиректор переходов /go/...
PUBLIC_BASE_URL=https://vinyl-vertushka.ru

# Счётчик Яндекс.Метрики для публичных веб-страниц. Пусто = не встраивается.
# Включать только после добавления раздела про аналитику и куки в privacy.html.
YANDEX_METRIKA_COUNTER_ID=

# Блок «Поддержать проект» и страница /support.
# Боевая ссылка CloudTips уже стоит дефолтом в config.py — переменную задавать
# нужно, только если понадобится другая ссылка (например, отдельная под
# Telegram, чтобы разделить источники). Пустая строка выключает блок и делает
# /support 404 — так можно погасить сборы, не выкатывая код.
# ВАЖНО: только веб. В мобильном приложении этой ссылки быть не должно —
# App Store Guideline 3.1.1. См. docs/plans/PLAN_SUPPORT_PROJECT.md
#SUPPORT_URL=https://pay.cloudtips.ru/p/xxxxxxxx
# Публичный роадмап (открытые планы). Есть дефолт в config.py.
SUPPORT_PLANS_URL=https://timestripe.com/boards/sX8B5Keg/
