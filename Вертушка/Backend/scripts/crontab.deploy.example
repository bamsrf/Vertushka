# Эталон crontab юзера deploy на проде (85.198.85.12). Установлен 19.08.2026.
# Ручной crontab не виден из git — при изменении на сервере обновляй и этот файл.
# Проверить на сервере: crontab -l

# Ночной бэкап БД через обёртку: exec-бит не важен, провал уходит в Telegram.
0 4 * * * bash ~/vertushka/Вертушка/Backend/scripts/backup_cron_wrapper.sh

# Продление TLS. reload вместо restart: graceful, не рвёт WebSocket-соединения
# (до 19.08.2026 стоял restart — nginx рестартовал КАЖДУЮ ночь безусловно).
0 3 * * * cd ~/vertushka/Вертушка/Backend && docker compose -f docker-compose.prod.yml run --rm certbot renew >> ~/backups/certbot.log 2>&1 && docker exec vertushka_nginx nginx -s reload >> ~/backups/certbot.log 2>&1

# Дневной снапшот стоимости коллекций.
7 9 * * * bash ~/vertushka/Вертушка/Backend/scripts/backfill_snapshot.sh

# Замер ресурсов раз в 5 минут (добавлен 03.09.2026). Нужен, чтобы отличить
# плато памяти от ползучего роста: по одной точке это неразличимо.
# Скрипт: Backend/scripts/resource_sample.sh → ~/metrics/resource_sample.sh
# Отчёт:  bash ~/metrics/resource_sample.sh report
# Ставить/снимать НЕ руками — вставка ssh-однострочника уже один раз
# порвалась о перенос строки и крон молча не встал:
#   bash ~/metrics/install_metrics_cron.sh          — поставить
#   bash ~/metrics/install_metrics_cron.sh remove   — снять
# Строка временная — снять, когда вопрос по памяти закрыт.
*/5 * * * * bash ~/metrics/resource_sample.sh >> ~/metrics/sample.log 2>&1
